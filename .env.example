# Copy values into your local shell or hosting provider. Never commit real secrets.

# PostgreSQL connection string for deployment. Leave unset locally to use SQLite.
# Use sslmode=require for a hosted database.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require

# Public demo behavior. Set DEMO_MODE=true only for the fictional public demo.
DEMO_MODE=false
DEMO_WRITES_ENABLED=true

# Seed fictional demo rows only when the database is empty. Explicit and safe
# to leave on for the public demo; never set it for real financial records.
SEED_DEMO_DATA=false

# Local SQLite path (ignored when DATABASE_URL is set).
SCHOOLTRACK_DB=data/schooltrack.db

# Public-demo safeguards. Defaults are shown.
MAX_REQUEST_BYTES=262144
RATE_LIMIT_WRITES=30
RATE_LIMIT_WINDOW_SECONDS=60
TRUST_PROXY_HEADERS=false

# Required only for the owner-run `python -m app.manage reset-demo --yes` command.
ALLOW_DEMO_RESET=false
